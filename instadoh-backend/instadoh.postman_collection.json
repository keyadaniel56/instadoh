						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cross-border/quote?from_currency=KES&to_currency=UGX&amount=1000",
							"host": ["{{baseUrl}}"],
							"path": ["cross-border", "quote"],
							"query": [
								{
									"key": "from_currency",
									"value": "KES"
								},
								{
									"key": "to_currency",
									"value": "UGX"
								},
								{
									"key": "amount",
									"value": "1000"
								}
							]
						},
						"description": "KES ↔ UGX cross-border quote (2% fee, valid ~2 min)."
					},
					"response": []
				},
				{
					"name": "Send Cross-Border",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"recipient_phone\": \"256772123456\",\n  \"recipient_country\": \"UG\",\n  \"amount\": 1000,\n  \"currency\": \"KES\",\n  \"description\": \"school fees\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/cross-border/send",
