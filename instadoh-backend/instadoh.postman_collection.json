								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cross-border/transactions?page=1&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["cross-border", "transactions"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						},
						"description": "Paged cross-border transfer history."
					},
					"response": []
				},
				{
					"name": "Get Cross-Border Transaction",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/cross-border/transactions/1",
							"host": ["{{baseUrl}}"],
							"path": ["cross-border", "transactions", "1"]
						},
						"description": "Cross-border transfer detail."
					},
					"response": []
				}
			]
		},
		{
			"name": "M-Pesa (Kenya)",
			"item": [
				{
					"name": "Deposit (STK Push)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone_number\": \"254712345678\",\n  \"amount\": 500\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/mpesa/deposit",
							"host": ["{{baseUrl}}"],
							"path": ["mpesa", "deposit"]
						},
						"description": "Prompt an M-Pesa STK Push to fund the wallet. Requires MPESA_CONSUMER_KEY/SECRET configured."
					},
					"response": []
				},
				{
					"name": "Withdraw (B2C)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone_number\": \"254712345678\",\n  \"amount\": 500\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/mpesa/withdraw",
							"host": ["{{baseUrl}}"],
							"path": ["mpesa", "withdraw"]
						},
						"description": "Send money from the wallet to an M-Pesa number. Deducts balance, pays via B2C."
					},
					"response": []
				},
				{
					"name": "STK Callback",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"Body\": {\n    \"stkCallback\": {\n      \"MerchantRequestID\": \"m-1\",\n      \"CheckoutRequestID\": \"ws_CO_1\",\n      \"ResultCode\": 0,\n      \"ResultDesc\": \"The service request is processed successfully.\",\n      \"CallbackMetadata\": {\n        \"Item\": [\n          { \"Name\": \"Amount\", \"Value\": 500 },\n          { \"Name\": \"MpesaReceiptNumber\", \"Value\": \"SGH123456\" },\n          { \"Name\": \"PhoneNumber\", \"Value\": 254712345678 }\n        ]\n      }\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/mpesa/callback",
							"host": ["{{baseUrl}}"],
							"path": ["mpesa", "callback"]
						},
						"description": "Safaricom STK-Push callback. Credits the user's balance when ResultCode is 0. Use the CheckoutRequestID from a real deposit response."
					},
					"response": []
				},
				{
					"name": "B2C Result Callback",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"Result\": {\n    \"ConversationID\": \"AG_1\",\n    \"ResultCode\": 0,\n    \"ResultDesc\": \"Success\",\n    \"TransactionID\": \"SGH654321\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/mpesa/result",
							"host": ["{{baseUrl}}"],
							"path": ["mpesa", "result"]
						},
						"description": "B2C result callback. Refunds the user if ResultCode != 0."
					},
					"response": []
				}
			]
		},
